@echo off
setlocal
set "AI_MASTER_OS_HOME=%USERPROFILE%\Desktop\AI Master OS"
set "AI_MASTER_OS_CORE=%AI_MASTER_OS_HOME%\01_CORE_RUNTIME"
set "AI_MASTER_OS_UI=%AI_MASTER_OS_HOME%\02_UI_CONSOLE"
set "AI_MASTER_OS_RELEASES=%AI_MASTER_OS_HOME%\03_RELEASES"
set "AI_MASTER_OS_AUDITS=%AI_MASTER_OS_HOME%\05_AUDITS"

if not exist "%AI_MASTER_OS_CORE%\src" (
  echo AI Master OS workspace not found: %AI_MASTER_OS_CORE%
  exit /b 1
)

set "PYTHONPATH=%AI_MASTER_OS_CORE%"
set "PYTHONWARNINGS=error::ResourceWarning"

echo AI_MASTER_OS_HOME=%AI_MASTER_OS_HOME%
echo AI_MASTER_OS_CORE=%AI_MASTER_OS_CORE%
echo AI_MASTER_OS_UI=%AI_MASTER_OS_UI%
echo PYTHONPATH=%PYTHONPATH%
endlocal & (
  set "AI_MASTER_OS_HOME=%AI_MASTER_OS_HOME%"
  set "AI_MASTER_OS_CORE=%AI_MASTER_OS_CORE%"
  set "AI_MASTER_OS_UI=%AI_MASTER_OS_UI%"
  set "AI_MASTER_OS_RELEASES=%AI_MASTER_OS_RELEASES%"
  set "AI_MASTER_OS_AUDITS=%AI_MASTER_OS_AUDITS%"
  set "PYTHONPATH=%PYTHONPATH%"
  set "PYTHONWARNINGS=%PYTHONWARNINGS%"
)
