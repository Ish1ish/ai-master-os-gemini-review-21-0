# Inject through a secret manager / protected environment file. Never commit populated values.
AI_OS_ENV=production
AI_OS_IDENTITY_SIGNING_SECRET=REPLACE_WITH_32_PLUS_BYTE_RANDOM_SECRET

# Provider endpoint URLs are complete HTTPS request URLs for the host adapters.
AI_OS_MODEL_BASE_URL=
AI_OS_MODEL_API_KEY=
AI_OS_MODEL_NAME=
AI_OS_SEARCH_BASE_URL=
AI_OS_SEARCH_API_KEY=

AI_OS_MEMORY_DB_PATH=/opt/ai-master-os/data/memory.sqlite3
AI_OS_AUDIT_DB_PATH=/opt/ai-master-os/data/audit.sqlite3
AI_OS_JOBS_DB_PATH=/opt/ai-master-os/data/jobs.sqlite3
AI_OS_REQUEST_TIMEOUT_S=30
AI_OS_API_PORT=8080
