{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "approval_id",
    "run_id",
    "action",
    "status",
    "requested_by",
    "created_at",
    "expires_at"
  ],
  "properties": {
    "approval_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "action": {
      "type": "string"
    },
    "status": {
      "enum": [
        "PENDING",
        "APPROVED",
        "REJECTED",
        "EXPIRED"
      ]
    },
    "requested_by": {
      "type": "string"
    },
    "decided_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    }
  }
}