{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Master OS O32 API Transport v1",
  "type": "object",
  "required": [
    "health",
    "readiness",
    "runs",
    "run_status",
    "execute",
    "cancel"
  ],
  "properties": {
    "health": {
      "const": "/health"
    },
    "readiness": {
      "const": "/readiness"
    },
    "runs": {
      "const": "POST /runs"
    },
    "run_status": {
      "const": "GET /runs/{job_id}"
    },
    "execute": {
      "const": "POST /runs/{job_id}/execute"
    },
    "cancel": {
      "const": "POST /runs/{job_id}/cancel"
    }
  },
  "additionalProperties": false
}