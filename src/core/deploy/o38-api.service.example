[Unit]
Description=AI Master OS O38 Production API
After=network.target

[Service]
WorkingDirectory=/opt/ai-master-os
EnvironmentFile=/etc/ai-master-os/production.env
ExecStart=/usr/bin/python3 -m src.server --host 127.0.0.1 --port 8080 --db /opt/ai-master-os/data/jobs.sqlite3
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ai-master-os/data

[Install]
WantedBy=multi-user.target
